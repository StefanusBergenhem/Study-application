---
# Architecture Decision Record — one decision per file.
# Place files under `paths.adrs` (default: docs/adrs/), named `ADR-NNN-short-slug.md`.
#
# An ADR is warranted only when ALL three conditions hold (see
# skills/wf-skill-spec-references/references/adr-threshold.md):
#   1. Load-bearing — reversing it ripples beyond local scope.
#   2. ≥2 real options existed, with real trade-offs.
#   3. Contingent on assumptions that could plausibly change.
#
# Routine choices, defaults, or one-option-only decisions do NOT earn ADRs.

id:                ADR-NNN                    # monotonic within the project
status:            accepted                   # proposed | accepted | superseded | deprecated
date:              "{{ISO_DATE}}"
title:             "<short noun phrase>"
governs_components: [<component-id>, ...]     # which COMPONENTS.yaml entries this ADR shapes
supersedes:        null                       # ADR-id this one replaces, or null
superseded_by:     null                       # ADR-id that replaces this one, or null
traces_to:         []                         # optional: roadmap capability (CAP-NNN) or external constraint (EXT-NNN) ids that drove the decision
---

